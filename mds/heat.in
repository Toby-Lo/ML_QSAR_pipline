Gradual Heating from 0 to 300K under NVT
&cntrl
  imin=0, irest=0, ntx=1,
  nstlim=25000, dt=0.002,
  ntc=2, ntf=2,
  cut=10.0,
  ntb=1,                   ! NVT
  ntt=3, gamma_ln=2.0,     ! Langevin thermostat
  tempi=0.0, temp0=300.0,
  ioutfm=1, ntxo=2,         ! NetCDF traj + restart
  ntpr=500, ntwx=500, ntwr=5000,
  nscm=1000,                ! Remove COM translation
  ig=-1,
  ntr=1,
  restraintmask=':1-319 & !@H=',
  restraint_wt=5.0,
  nmropt=1, vlimit=20
/
&wt TYPE='TEMP0', istep1=0, istep2=25000,
     value1=0.1, value2=300.0 /
&wt TYPE='END' /
