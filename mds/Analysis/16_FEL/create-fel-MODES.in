#!/bin/bash
read -p "Enter input names:" name1
MDINPUTS=($name1)
for input in ${MDINPUTS[@]}; do
	awk '$1 == "1", $1 == "5000" { print $1,$2}' ${input}_projection.txt > ${input}_MODE1.xvg
	awk '$1 == "1", $1 == "5000" { print $1,$3}' ${input}_projection.txt > ${input}_MODE2.xvg
done

#run it and give the name of file 
